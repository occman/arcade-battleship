# Copy to .env.local (git-ignored). Used only by the dev/preview server for the in-game "Report Bug" button.
# Create a service user + API key in Devin: Settings > Service users. Keys start with "cog_".
DEVIN_API_KEY=
# Organization ID (prefix "org-"), shown in Devin settings.
DEVIN_ORG_ID=
# GitHub URL of this repo so the Devin Cloud agent knows where to fix things.
DEVIN_REPO=
# Set to 1 to also expose /api/report-bug on `npm run preview` (off by default: a
# preview server started with --host would let anyone on the network create sessions).
DEVIN_BUG_REPORT_PREVIEW=
